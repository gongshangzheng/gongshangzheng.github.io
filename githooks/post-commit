#!/usr/bin/env bash
# post-commit hook — site-architecture change → skill self-evolution reminder.
#
# Non-blocking: this runs AFTER the commit has been created, so any failure
# here never disturbs the commit. All real logic lives in the Node helper
# scripts/skill-evolution-hook.js to stay consistent with the project's
# Node-based toolchain and to remain testable on its own.

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
HELPER="$REPO_ROOT/scripts/skill-evolution-hook.js"

# Skip silently if the helper is absent (partial clone, fresh checkout, etc.)
[ -f "$HELPER" ] || exit 0

# Run the helper; let its reminder (on stderr) show through. A runtime error
# is harmless for a post-commit hook, and `|| true` keeps the exit code clean.
if command -v node >/dev/null 2>&1; then
  node "$HELPER" HEAD || true
fi

exit 0
